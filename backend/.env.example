# ==============================================================================
# PLASTIFY Platform - Environment Configuration Template
# Copy this file to .env and adjust variables for your deployment environment.
# NEVER commit sensitive production credentials or keys to source control.
# ==============================================================================

# Project & Runtime Environment
PROJECT_NAME="PLASTIFY"
PROJECT_DESCRIPTION="Production-grade plastic recovery verification and circular-economy platform backend."
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Structured Logging (json in production/staging, console in development)
LOG_LEVEL="INFO"
LOG_FORMAT="console"

# Security & Secrets (generate a secure random 64+ char secret in production)
SECRET_KEY="generate-a-secure-random-secret-key-for-production-min-32-chars"
ALLOWED_HOSTS="localhost,127.0.0.1,*"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:8000"
REQUEST_ID_HEADER="X-Request-ID"

# PostgreSQL Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="plastify_user"
POSTGRES_PASSWORD="plastify_password"
POSTGRES_DB="plastify_db"

# Optional explicit connection URL overrides (if using external managed services like AWS RDS / Supabase)
# ASYNC_DATABASE_URL="postgresql+asyncpg://user:pass@host:5432/dbname"
# DATABASE_URL="postgresql+psycopg2://user:pass@host:5432/dbname"

# Database Connection Pool Tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Redis Cache & Broker Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""
# REDIS_URL="redis://:password@localhost:6379/0"

# Celery Worker URLs
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# S3-Compatible Object Storage (MinIO locally / AWS S3 in production)
S3_ENDPOINT_URL="http://localhost:9000"
S3_REGION_NAME="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET_NAME="plastify-evidence"
S3_USE_SSL=false
S3_SIGNED_URL_EXPIRE_SECONDS=900

# Evidence & File Upload Limits
MAX_EVIDENCE_FILE_SIZE_BYTES=15728640
MALWARE_SCANNER_TYPE="mock"

# Logistics & Delivery
DEFAULT_WEIGHT_TOLERANCE_PERCENT=2.0
